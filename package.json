{
  "name": "imou-notifi",
  "version": "2.0.0",
  "private": true,
  "description": "Configurable camera snapshots, recording, Telegram video queue and Drive backup",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import ./tests/environment.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "onvif": "^0.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
