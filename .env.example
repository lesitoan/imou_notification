# Copy to .1.env (Debian) or .2.env (countryside). Never commit real credentials.
SITE_ID=que
CAMERA_COUNT=2
CAMERA_1_HOST=192.168.1.3
CAMERA_1_PORT=80
CAMERA_1_USERNAME=admin
CAMERA_1_PASSWORD=
CAMERA_1_RTSP_URL=rtsp://admin:password@192.168.1.3:554/cam/realmonitor?channel=1&subtype=0
CAMERA_1_NAME=Bếp
CAMERA_2_HOST=192.168.1.4
CAMERA_2_PORT=80
CAMERA_2_USERNAME=admin
CAMERA_2_PASSWORD=
CAMERA_2_RTSP_URL=rtsp://admin:password@192.168.1.4:554/cam/realmonitor?channel=1&subtype=0
CAMERA_2_NAME=Sân
CAMERA_RECONNECT_SECONDS=10
SNAPSHOT_TIMEOUT_SECONDS=20
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PHOTO_ENABLED=true
PHOTO_TRIGGER=motion_start
PHOTO_FAILURE_ACTION=log
VIDEO_ENABLED=true
VIDEO_MODE=fixed
VIDEO_DURATION_SECONDS=15
VIDEO_POST_DELAY_SECONDS=10
VIDEO_MAX_DURATION_SECONDS=300
TELEGRAM_VIDEO_ENABLED=true
VIDEO_SEND_INTERVAL_SECONDS=5
VIDEO_QUEUE_MAX_SIZE=20
VIDEO_QUEUE_MAX_BYTES=524288000
VIDEO_PENDING_MAX_AGE_HOURS=24
VIDEO_UPLOAD_MAX_ATTEMPTS=10
TELEGRAM_VIDEO_MAX_BYTES=50331648
TELEGRAM_VIDEO_MAX_SECONDS=60
TELEGRAM_VIDEO_UPLOAD_TIMEOUT_SECONDS=180
LOCAL_VIDEO_ENABLED=false
LOCAL_SNAPSHOT_ENABLED=false
LOCAL_RETENTION_DAYS=3
CLEANUP_INTERVAL_MINUTES=60
PROTECT_PENDING_DELIVERIES=true
MIN_FREE_DISK_BYTES=268435456
DRIVE_UPLOAD_ENABLED=false
DRIVE_UPLOAD_VIDEOS=true
DRIVE_UPLOAD_SNAPSHOTS=true
DRIVE_UPLOAD_INTERVAL_SECONDS=300
DRIVE_UPLOAD_BWLIMIT=2M
DRIVE_UPLOAD_TIMEOUT_SECONDS=300
DRIVE_REMOTE=gdrive:Camera_Que
DRIVE_RCLONE_CONFIG=/run/secrets/rclone.conf
DATA_PATH=/data
RECORDING_PATH=/data/recordings
SNAPSHOT_PATH=/data/snapshots
TZ=Asia/Ho_Chi_Minh
APP_IMAGE=lesitoan/imou-notifi:2.0.1
APP_ENV_FILE=.2.env
APP_CONTAINER_NAME=imou-snapshot-que
APP_DATA_DIR=./data
APP_SECRETS_DIR=./secrets
